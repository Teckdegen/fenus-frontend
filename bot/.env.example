# ═══════════════════════════════════════════════════════════════════════════════
# LitVM LiteForge (defaults — bot.js uses these if vars are omitted)
# ═══════════════════════════════════════════════════════════════════════════════
# Network name    LitVM LiteForge
# Chain ID        4441
# Gas token       zkLTC
#
# RPC (HTTP)      https://liteforge.rpc.caldera.xyz/http
# RPC (WebSocket) wss://liteforge.rpc.caldera.xyz/ws
#
# Block explorer  https://liteforge.explorer.caldera.xyz
#
# Deployed: 2026-05-03T18:40:32.104Z
# Deployer: 0xdb4034fA3829B488eFc1FC0f01F5F1Af722562Df
# Treasury: 0xdb4034fA3829B488eFc1FC0f01F5F1Af722562Df
# ═══════════════════════════════════════════════════════════════════════════════

# WebSocket — bot listens for new blocks (defaults to LiteForge if unset)
RPC_WS=wss://liteforge.rpc.caldera.xyz/ws

# HTTP — optional extra reads / debugging (defaults to LiteForge if unset)
RPC_HTTP=https://liteforge.rpc.caldera.xyz/

# Optional overrides (otherwise bot uses LiteForge defaults above)
# NETWORK_NAME=LitVM LiteForge
# CHAIN_ID=4441
# GAS_TOKEN=zkLTC
# BLOCK_EXPLORER=https://liteforge.explorer.caldera.xyz
# BLOCK_EXPLORER_URL is accepted as an alias for BLOCK_EXPLORER

# ─── Bot wallet ───────────────────────────────────────────────────────────────
# Private key of the wallet that pays gas for liquidation txs
# Keep this secret — never commit the real .env
PRIVATE_KEY=0xyour_private_key_here

# ═══════════════════════════════════════════════════════════════════════════════
# Telegram Notifications — Get real-time alerts for liquidations & arbitrage
# ═══════════════════════════════════════════════════════════════════════════════
# Create a bot: https://t.me/BotFather
# Get your chat ID: https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

