# ─── RPC endpoints ────────────────────────────────────────────────────────────
# WebSocket — required for instant new-block events
RPC_WS=wss://your-node.example.com/ws

# HTTP — used for fallback calls
RPC_HTTP=https://your-node.example.com

# ─── Bot wallet ───────────────────────────────────────────────────────────────
# Private key of the wallet that pays gas for liquidation txs
# Keep this secret — never commit the real .env
PRIVATE_KEY=0xyour_private_key_here

# ─── Contract addresses (fill in after deployment) ────────────────────────────
TROVE_MANAGER_ADDRESS=0x
SORTED_TROVES_ADDRESS=0x
PRICE_FEED_ADDRESS=0x

# ─── Optional tuning ──────────────────────────────────────────────────────────
# Re-sync full Trove list every N blocks (catches missed events)
FULL_RESYNC_INTERVAL=300

# Addresses per multicall batch (lower if RPC rejects large payloads)
MULTICALL_BATCH_SIZE=500

# Max Troves per batchLiquidate() tx
LIQUIDATION_BATCH_SIZE=50
