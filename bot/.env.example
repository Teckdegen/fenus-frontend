# ADDRESSES_REGISTRY=0xbE63a640395295b3A49228d5920796fB94690E8E
# WZK_LTC=0xa779d43BCaBda81f3324d11392f4ae35Bb2Fbfec
# FNUSD=0x39d3861C1E60823b95f545f41dD3cb45f1f529AD
# ACTIVE_POOL=0x60cebB7639eF69a1889602d1b8441390fAF59A56
# DEFAULT_POOL=0x3ca147c8f183468EFC6b67A783A71d2c12f094d3
# COLL_SURPLUS_POOL=0x042c42e51006E49dbBb1A42061868CC64B0469a0
# GAS_POOL=0xb50b0F1Fb8299Fd51aC3C84b3841C8177dF708D5
# BORROWER_OPERATIONS=0xf8Df45015eccE114053CA71D493523bd75F17C68
# REDEMPTION_HELPER=0x39EF4E7412f9220435016A0B51F048FFa7424473
# HINT_HELPERS=0xCa4D74D08AB440529f4fa1c10B552F3242C6aFD7
# COLLATERAL_REGISTRY=0x240d8A34C4E9350Cf23f4145191e8312D62e1fA0

# ─── Optional tuning ──────────────────────────────────────────────────────────
FULL_RESYNC_INTERVAL=300
MULTICALL_BATCH_SIZE=500
LIQ_BATCH_SIZE=50

# MULTICALL_CONCURRENCY=6
# GAS_LIMIT_BPS=12000
# GAS_SINGLE_FALLBACK=800000
# GAS_BATCH_FALLBACK=5000000
