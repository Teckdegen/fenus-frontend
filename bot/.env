# ═══════════════════════════════════════════════════════════════════════════════
# PegKeeper Configuration — Maintains FnUSD at $1 peg via automated trading
# ═══════════════════════════════════════════════════════════════════════════════
# Enable/disable PegKeeper (set to "true" to enable)
ENABLE_PEG_KEEPER=false

# Token addresses
FNUSD_ADDRESS=0x219F2AC287458cD58aB46ABd3cfbe451728323f4
AUSDC_ADDRESS=0x

# Addax DEX addresses
POOL_ADDRESS=0x
ROUTER_ADDRESS=0x

# FENUS protocol addresses (for auto-borrow/repay)
BORROWER_OPS_ADDRESS=0x70ae94769345031F7fC9C611d8bC822bCFcfB111
WZKLITECOIN_ADDRESS=0xa779d43BCaBda81f3324d11392f4ae35Bb2Fbfec

# Price targets and thresholds
TARGET_PRICE=1.0
UPPER_THRESHOLD=1.02
LOWER_THRESHOLD=0.98

# Trade limits (in FnUSD)
MIN_TRADE_AMOUNT=100
MAX_TRADE_AMOUNT=10000

# Check interval (seconds)
PEG_CHECK_INTERVAL=60

# Auto-borrow FnUSD if balance is low (set to "true" to enable)
ENABLE_AUTO_BORROW=false

# Auto-repay debt if excess FnUSD (set to "true" to enable)
ENABLE_AUTO_REPAY=false

# ─── Optional tuning ──────────────────────────────────────────────────────────
FULL_RESYNC_INTERVAL=300
MULTICALL_BATCH_SIZE=500
LIQ_BATCH_SIZE=50

# MULTICALL_CONCURRENCY=6
# GAS_LIMIT_BPS=12000
# GAS_SINGLE_FALLBACK=800000
# GAS_BATCH_FALLBACK=5000000
