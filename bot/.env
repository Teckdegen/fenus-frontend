# ═══════════════════════════════════════════════════════════════════════════════
# LitVM LiteForge (defaults — bot.js uses these if vars are omitted)
# ═══════════════════════════════════════════════════════════════════════════════
# Network name    LitVM LiteForge
# Chain ID        4441
# Gas token       zkLTC
#
# RPC (HTTP)      https://liteforge.rpc.caldera.xyz/http
# RPC (WebSocket) wss://liteforge.rpc.caldera.xyz/ws
#
# Block explorer  https://liteforge.explorer.caldera.xyz
# ═══════════════════════════════════════════════════════════════════════════════

# WebSocket — bot listens for new blocks (defaults to LiteForge if unset)
RPC_WS=wss://liteforge.rpc.caldera.xyz/ws

# HTTP — optional extra reads / debugging (defaults to LiteForge if unset)
RPC_HTTP=https://liteforge.rpc.caldera.xyz/http

# Optional overrides (otherwise bot uses LiteForge defaults above)
# NETWORK_NAME=LitVM LiteForge
# CHAIN_ID=4441
# GAS_TOKEN=zkLTC
# BLOCK_EXPLORER=https://liteforge.explorer.caldera.xyz
# BLOCK_EXPLORER_URL is accepted as an alias for BLOCK_EXPLORER

# ─── Bot wallet ───────────────────────────────────────────────────────────────
# Private key of the wallet that pays gas for liquidation txs
# Keep this secret — never commit the real .env
PRIVATE_KEY=0xyour_private_key_here

# ═══════════════════════════════════════════════════════════════════════════════
# Contracts — REQUIRED by bot.js (three addresses only)
# ═══════════════════════════════════════════════════════════════════════════════
TROVE_MANAGER_ADDRESS=0x
SORTED_TROVES_ADDRESS=0x
PRICE_FEED_ADDRESS=0x

# Example deployment (same network — from repo src/lib/contracts.ts):
# TROVE_MANAGER_ADDRESS=0xC3923969Ab8f41770404551FD9C1cdd2F7015168
# SORTED_TROVES_ADDRESS=0xa05Dc95342Cc85b128d0dD9f5F358d788FdB2c1f
# PRICE_FEED_ADDRESS=0x54854DDFB398e229e26ae3B77fD7feaF9404Ca90

# ═══════════════════════════════════════════════════════════════════════════════
# Full FENUS deployment map (reference — bot.js does NOT read these yet)
# ═══════════════════════════════════════════════════════════════════════════════
# ADDRESSES_REGISTRY=0x7C624C6f66A51A869D50e23993222e12e2a81bf1
# WZK_LTC=0xa779d43BCaBda81f3324d11392f4ae35Bb2Fbfec
# FNUSD=0x58418903D69f6DCbbEbCba3dEb733A4d756863a4
# ACTIVE_POOL=0xa35ed6B20d621403e514Ef15826615F4094C835A
# DEFAULT_POOL=0xDC441937F49ff3A63A195b2dBE74715d9A131883
# COLL_SURPLUS_POOL=0x270489f04edF58C193352581AE72A8ef7f8b48B7
# GAS_POOL=0xDcCC21F7630122DE540a3006A28560E31B0A82CD
# BORROWER_OPERATIONS=0x4411dDC4C6352811730c07906dcD539d762E7c6e
# REDEMPTION_HELPER=0xC3259D46ac623DaA8cA433500C6743D967B87BE5
# HINT_HELPERS=0x02bd7C24bdc204CA85AF18129D7D00CF60b50be6
# COLLATERAL_REGISTRY=0x3656F241776e302F59e5a86F72d10a22631eeb2B

# ─── Optional tuning ──────────────────────────────────────────────────────────
FULL_RESYNC_INTERVAL=300
MULTICALL_BATCH_SIZE=500
LIQ_BATCH_SIZE=50

# MULTICALL_CONCURRENCY=6
# GAS_LIMIT_BPS=12000
# GAS_SINGLE_FALLBACK=800000
# GAS_BATCH_FALLBACK=5000000
