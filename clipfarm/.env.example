### Chain / RPC
CLIPFARM_RPC_URL=https://liteforge.rpc.caldera.xyz/http
CLIPFARM_CHAIN_ID=4441

### Admin funding wallet (NEVER commit)
ADMIN_PRIVATE_KEY=

### Supabase (service role recommended for server-side jobs; NEVER commit)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

### 32-byte key (base64) for encrypting private keys at rest
### Generate (Node): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLIPFARM_ENCRYPTION_KEY_BASE64=

### Contracts (defaults match your app's liteforge deploy; override if needed)
WZKLTC_ADDRESS=0xa779d43BCaBda81f3324d11392f4ae35Bb2Fbfec
FNUSD_ADDRESS=0x39d3861C1E60823b95f545f41dD3cb45f1f529AD
BORROWER_OPERATIONS_ADDRESS=0xf8Df45015eccE114053CA71D493523bd75F17C68
TROVE_MANAGER_ADDRESS=0x19Ddd6D9F750d8b9f4CD1E93B09b46CC27a36638

### Funding + behavior
FUND_NATIVE_GAS=0.002
FUND_WZKLTC=2.0
OPEN_TROVE_DEPOSIT_WZKLTC=1.0
OPEN_TROVE_BORROW_MIN_FNUSD=39
OPEN_TROVE_BORROW_MAX_FNUSD=5000

### Pace
WALLETS_PER_24H=2000

### Activity
DAILY_ACTION=repay        # repay | borrow | addColl | mixed
DAILY_MAX_ACTIONS_PER_WALLET_PER_24H=1
DAILY_FNUSD_MIN=1
DAILY_FNUSD_MAX=50
DAILY_WZKLTC_MIN=0.001
DAILY_WZKLTC_MAX=0.05

### Internal transfers between wallets
ENABLE_INTERNAL_TRANSFERS=true
INTERNAL_TRANSFER_EVERY_MINUTES=10
INTERNAL_TRANSFER_FNUSD_MIN=0.5
INTERNAL_TRANSFER_FNUSD_MAX=5
INTERNAL_TRANSFER_WZKLTC_MIN=0.0001
INTERNAL_TRANSFER_WZKLTC_MAX=0.01

