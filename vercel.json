{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "routes": [
    {
      "src": "/blog/([^/]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|telegram|twitter|twitterbot|facebookexternalhit|linkedinbot|slackbot|discordbot|telegrambot|googlebot|bingbot|applebot|pinterest|vkshare|w3c_validator|curl|wget|python-requests|go-http-client|java|bot|crawler|spider|scraper).*"
        }
      ],
      "dest": "/api/blog-meta?slug=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
